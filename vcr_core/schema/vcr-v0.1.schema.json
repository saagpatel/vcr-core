{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saagarpatel.dev/schema/vcr/v0.1",
  "title": "Verified-Check Record (VCR) v0.1",
  "description": "The frozen VCR v0.1 spine, owned here (vcr-core) and imported by N2 and HarnessBench. v0.1 is an additive extension of v0 signed off by home base 2026-08-16: it adds the optional check.polarity field (must_block|must_allow) and the verdict.result values over_blocked and declined. Backward-compatible with v0 (nothing removed).",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "predicateType": { "const": "https://saagarpatel.dev/schema/vcr/v0.1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "digest"],
        "properties": {
          "kind": { "type": "string", "enum": ["harness_config", "work_product", "artifact", "skill_bundle", "mcp_server"] },
          "name": { "type": "string" },
          "mediaType": { "type": "string" },
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string", "pattern": "^sha256:" } }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["check", "verdict", "evidence", "runtime", "provenance"],
      "properties": {
        "check": {
          "type": "object",
          "required": ["id", "category", "version"],
          "properties": {
            "id": { "type": "string" },
            "category": { "type": "string", "enum": ["guard", "policy", "quality", "provenance"] },
            "version": { "type": "string" },
            "polarity": { "type": "string", "enum": ["must_block", "must_allow"] },
            "config_ref": {
              "type": "object",
              "required": ["sha256"],
              "properties": { "sha256": { "type": "string", "pattern": "^sha256:" } }
            }
          }
        },
        "verdict": {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": { "type": "string", "enum": ["pass", "fail", "bypassed", "over_blocked", "declined", "not_applicable", "error"] },
            "enforced": { "type": "string", "enum": ["enforced", "advisory", "observed", "absent"] },
            "score": { "type": "number" }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["kind", "grade", "digest"],
          "properties": {
            "kind": { "type": "string" },
            "grade": { "type": "string", "enum": ["A", "B", "C"] },
            "digest": {
              "type": "object",
              "required": ["sha256"],
              "properties": { "sha256": { "type": "string", "pattern": "^sha256:" } }
            },
            "uri": { "type": "string" },
            "inline": { "type": "string" }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["ran_at", "runner"],
          "properties": {
            "ran_at": { "type": "string" },
            "runner": { "type": "string" },
            "duration_ms": { "type": "number" },
            "env_digest": { "type": "string" }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["authority", "trust", "instruction_boundary"],
          "properties": {
            "authority": { "type": "string" },
            "trust": { "type": "string" },
            "instruction_boundary": { "type": "string", "enum": ["direct", "injected"] }
          }
        }
      }
    }
  }
}
